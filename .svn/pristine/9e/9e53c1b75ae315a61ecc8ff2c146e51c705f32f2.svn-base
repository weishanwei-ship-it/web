.dingding-qrcode-login-modal .relative{padding:0!important}.card-wrap[data-v-b687db3b]{width:100%;padding:10px}.card-grid[data-v-b687db3b]{grid-template-columns:1fr 1fr;gap:16px;display:grid}.card-item[data-v-b687db3b]{text-align:center;cursor:pointer;background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:20px 12px;transition:all .2s}.card-item[data-v-b687db3b]:hover{border-color:#3b82f6;transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08)}.card-icon[data-v-b687db3b]{margin-bottom:12px;font-size:32px}.card-title[data-v-b687db3b]{margin:0 0 6px;font-size:16px;font-weight:600}.card-desc[data-v-b687db3b]{color:#6b7280;margin:0;font-size:13px}
