              size="middle"
              :pagination="false"
              class="mb-4"
            />

            <!-- 最终结果 -->
            <a-alert
              message="计算完成，全部满足标准要求"
              type="success"
              show-icon
            />
          </Card>
        </div>
      </div>

      <!-- ======================
        🔥 上一步 / 下一步 按钮
      ======================= -->
        <div class="mt-4 flex justify-between items-center gap-4">
          <!-- 左侧：上一步 / 下一步 / 完成 -->
          <div class="flex gap-2">
            <Button :disabled="current === 0" @click="current--">上一步</Button>
            <Button v-if="current !== 5" type="primary" @click="current++">下一步</Button>
            <Button v-if="current === 5" type="primary">完成</Button>
          </div>

          <!-- 右侧：三个操作按钮 -->
          <div class="flex gap-2">
            <Button @click="saveTemp" type="primary">
              <i class="fas fa-save"></i> 临时保存
            </Button>
            <Button @click="saveFinal" type="primary">
              <i class="fas fa-database"></i> 存入数据库
            </Button>
            <Button @click="calcNow" type="primary">
              <i class="fas fa-calculator"></i> 实时计算
            </Button>
          </div>
        </div>
    </div>
  </Modal>
</template>
