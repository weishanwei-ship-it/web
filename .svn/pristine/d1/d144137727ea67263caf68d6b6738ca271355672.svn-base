  { label: 'API标准', value: 'API' },
  { label: 'TSG规范', value: 'TSG' },
];
const targetOptions = [
  { label: '执行机构', value: 'actuator' },
  { label: '阀本体', value: 'valve' },
];
const form = ref({

  产品型号:'',
