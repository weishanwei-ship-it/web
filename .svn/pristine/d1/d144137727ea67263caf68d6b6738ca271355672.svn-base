];
// 按钮方法
function exportExcel() { console.log('导出Excel'); }
function exportPDF() { console.log('导出PDF'); }
function exportSummary() { console.log('导出汇总'); }
function saveFinal() { console.log('保存数据库'); }
function print() { console.log('打印'); }

function saveTemp() { console.log('临时保存成功'); }
function calcNow() { console.log('实时计算完成'); }
// 弹窗配置
const [Modal, modalApi] = useVbenModal({
  title: '设计计算',
  onCancel() {
    modalApi.close();
  },
  onConfirm() {
    modalApi.close();
  },
  onOpenChange(isOpen: boolean) {
    if (isOpen) {
      data.value = modalApi.getData<Record<string, any>>();
      
      datacontent.value = data.value.content;
      
      form.value = {...datacontent.value};
       //Object.assign(form.value, datacontent.value);
    }
  },
  
});


// 必须暴露给父组件调用
defineExpose({
  modalApi,
});
</script>

