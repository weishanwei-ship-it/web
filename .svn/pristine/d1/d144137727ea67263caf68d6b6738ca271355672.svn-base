})

const columns = [
  { title: '参数', dataIndex: 'param', key: 'param' },
  { title: '计算值', dataIndex: 'value', key: 'value' },
  { title: '标准要求', dataIndex: 'standard', key: 'standard' },
  { title: '结果', dataIndex: 'result', key: 'result' },
];

const tableData = [
  { param: 'Cv流量系数', value: '92.4', standard: '≥85', result: '合格' },
  { param: '阀体强度', value: '合格', standard: '合格', result: '合格' },
