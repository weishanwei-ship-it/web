.t-rate{align-items:center;display:flex}.t-rate .t-rate__star-top{width:0;height:100%;transition:all .2s cubic-bezier(.38,0,.24,1);position:absolute;top:0;left:0;overflow:hidden}.t-rate .t-rate__star-top,.t-rate .t-rate__star-bottom{display:grid}.t-rate__list{margin:0;padding:0;list-style:none;display:flex}.t-rate__item{cursor:pointer;transition:all .2s cubic-bezier(.38,0,.24,1);position:relative}.t-rate__item:hover{transform:scale(1.33)}.t-rate__item--half .t-rate__star-top{width:50%}.t-rate__item--full .t-rate__star-top{width:100%}.t-rate__text{color:var(--td-text-color-primary);font:var(--td-font-mark-medium);margin-left:var(--td-comp-margin-l)}
